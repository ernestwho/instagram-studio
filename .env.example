# Dal pannello Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chiave-anon-pubblica

# Promemoria push (genera le chiavi con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=chiave-pubblica-vapid
VAPID_PRIVATE_KEY=chiave-privata-vapid
# Stesso valore salvato in studio.config_promemoria.segreto
PROMEMORIA_SEGRETO=un-testo-lungo-e-casuale
